# MongoDB Atlas Connection (for high-volume request logs & analytics)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/timeorbit?retryWrites=true&w=majority

# Neon Serverless PostgreSQL Connection (Crash-Proof Connection Pooler for Auth & API Keys)
# Grab this from your Neon Console (make sure it ends with -pooler.neon.tech)
DATABASE_URL=postgresql://<user>:<password>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
