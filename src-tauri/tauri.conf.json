{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "TimeOrbit",
  "version": "1.0.0",
  "identifier": "com.timeorbit.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://timeorbit-chi.vercel.app",
    "beforeBuildCommand": "",
    "frontendDist": "https://timeorbit-chi.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeOrbit - Planetary Observatory",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
